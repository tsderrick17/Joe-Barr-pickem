{
  "name": "joe-barr-pickem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test test/**/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 test/integration/**/*.test.mjs",
    "test:e2e": "playwright test",
    "test:season-drill": "node scripts/season-drill.mjs",
    "test:isolated": "node --env-file-if-exists=.env.test.local scripts/season-drill.mjs",
    "release:check": "node scripts/release-git.mjs check",
    "release:fetch": "node scripts/release-git.mjs fetch",
    "release:push": "node scripts/release-git.mjs push",
    "season:replay:sanitize": "node scripts/sanitize-season-replay.mjs",
    "season:certification:render": "node scripts/render-season-certification.mjs",
    "test:all": "npm run test:migrations && npm test",
    "test:migrations": "node scripts/check-migration-versions.mjs",
    "test:visual": "playwright test --config playwright.visual.config.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.72.0",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "fast-uri": "^4.1.4"
  },
  "allowScripts": {
    "@sentry/cli@2.58.6": true,
    "unrs-resolver@1.12.2": true
  }
}
